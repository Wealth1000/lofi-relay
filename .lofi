# -------------------------------------------------------------------
# lofi – play continuous lofi streams
# -------------------------------------------------------------------
#
# Three backends, one command (LOFI_BACKEND, default "worker"):
#
#   worker – fetch the resolver's document, play via a Cloudflare Worker that
#            strips video from muxed streams on the fly. Audio-only streams
#            pass through directly. Zero server cost, ~58 MB/hour regardless
#            of what YouTube serves the runner. No API key needed.
#   json   – same as worker but plays the raw GitHub-published URL directly.
#            Works when your residential IP gets audio-only rungs; falls back
#            to video bytes when the runner got muxed-fallback. Kept for
#            debugging and when the worker is not yet deployed.
#   relay  – the Render relay: resolves and strips server-side. Fallback for
#            when both worker and json paths fail. Free tier spins down, so
#            this path alone keeps the keep-alive pinger.

# File-scoped on purpose: helpers need them and a `local` in lofi() would not
# reach the forked restart loop's fetches.
lofi_base_json="https://raw.githubusercontent.com/Wealth1000/lofi-relay/master/data/streams.json"
# Deployed Cloudflare Worker: strips video from muxed streams on the fly,
# serves audio-only through Cloudflare's edge. Always on, no cold starts.
# Override with LOFI_WORKER_BASE if you deploy your own instance.
lofi_base_worker="${LOFI_WORKER_BASE:-}"

# Fetch the current playable URL for an endpoint from the published document.
# Prints nothing when the URL is unavailable (channel offline, entry null, or
# the document itself unreachable). A preserved-but-stale URL still prints:
# signed m3u8s stay valid for hours, so "stale" is "try it, the loop heals".
lofi_json_url() {
	local endpoint="$1"
	local docfile doc

	# mktemp, not a fixed /tmp name: curl -o would follow a pre-planted
	# symlink, which is exactly what the cover fetch guards against above.
	docfile="$(mktemp --suffix=.json -t lofi-doc-XXXXXX 2> /dev/null)" || return 1

	if ! curl -fsS -m 15 -o "$docfile" "$lofi_base_json" 2> /dev/null; then
		rm -f "$docfile"
		return 1
	fi

	doc="$(cat "$docfile")"
	rm -f "$docfile"
	jq -r --arg e "$endpoint" '.streams[$e].url // empty' <<<"$doc" 2> /dev/null
}

# Fetch the stream URL from the Cloudflare Worker.
# The worker returns {"url": "...", "variant": "..."} for audio-only or
# {"url": "<worker-rewritten-m3u8>", "variant": "muxed-fallback"} for muxed.
# In both cases the returned URL is directly playable by mpv.
lofi_worker_url() {
	local endpoint="$1"
	local resp
	resp="$(curl -fsS -m 15 "${lofi_base_worker}/api/play/${endpoint}" 2>/dev/null)" || return 1
	jq -r '.url // empty' <<<"$resp" 2>/dev/null
}

lofi() {
	local backend="${LOFI_BACKEND:-worker}"
	local relay_base="https://lofi-relay.onrender.com"
	# Relay auth key comes from the environment only — never from this file.
	# Set LOFI_API_KEY in the local, gitignored .env (or ~/.zshrc).
	local LOFI_API_KEY="${LOFI_API_KEY:-}"

	# flag:endpoint:label — one source of truth for help, dispatch and -R.
	# Endpoint names are canonical: the keys of app/config.py STREAMS. The
	# resolver publishes data/streams.json under the same names, so a
	# mismatch here is caught (and named) at startup, not mid-playback.
	local -a streams=(
		"h:lofi-house:Lofi House"
		"r:relax-study:Relax / Study"
		"b:summer-lofi:Summer Lofi"
		"d:sleep-dream:Sleep / Dream"
		"i:synth-ambient:Synth Ambient"
		"e:study-with-me:Study With Me"
		"n:sad-rainy:Rain / Sad"
		"a:asian-relax-study:Asian Relax / Study"
		"j:jazz-chill-study:Jazz / Chill Study"
		"s:sleep-chill:Sleep Chill"
		"p:piano-focus:Piano / Focus"
		"c:christmas-lofi:Christmas Lofi"
		"l:classical-study:Classical Study"
		"t:relaxing-jazz:Relaxing Jazz"
		"o:halloween-lofi:Halloween Lofi"
		"f:fireplace-ambience:Fireplace Ambience"
		"q:chill-guitar:Chill Guitar"
		"m:sleep-ambient:Sleep Ambient"
		"v:medieval-lofi:Medieval Lofi"
		"u:gentle-rain:Gentle Rain"
		"x:dark-ambient:Dark Ambient"
		"g:synthwave:Chill Game"
	)

	local entry

	if [[ "$1" == "-h" || "$1" == "--help" ]]; then
		echo "Usage: lofi [option]"
		echo ""
		echo "Lofi streams:"
		for entry in "${streams[@]}"; do
			printf "  -%-3s  %s\n" "${entry%%:*}" "${entry##*:}"
		done
		echo "  -R    Random stream"
		echo ""
		echo "Other:"
		echo "  -health    Check backend health"
		echo "  -h         Show this help"
		echo ""
		echo "Backend: ${LOFI_BACKEND:-worker} (set LOFI_BACKEND=json or relay to switch)"
		echo ""
		return 0
	fi

	if [[ "$1" == "-health" ]]; then
		# Not named `status`: that is a read-only alias for `$?` in zsh, and
		# `local status` aborts the function before curl ever runs.
		if [[ "$backend" == relay ]]; then
			local out rc
			out="$(curl -fsS -m 30 -H "X-API-Key: $LOFI_API_KEY" "$relay_base/health")"
			rc=$?

			if (( rc == 0 )); then
				print -r -- "$out"
			else
				print -u2 "lofi: health check failed (curl exit $rc)"
			fi

			return $rc
		fi

		# worker: health = can we reach the worker and get a valid response?
		if [[ "$backend" == worker ]]; then
			local wresp
			wresp="$(curl -fsS -m 15 "${lofi_base_worker}/api/streams" 2>/dev/null)" || {
				print -u2 "lofi: worker unreachable (curl exit $?)"
				return 1
			}
			local wstatus wupdated wplayable wtotal
			wstatus="$(jq -r '.status // "?"' <<<"$wresp")"
			wupdated="$(jq -r '.updated_at // "?"' <<<"$wresp")"
			wplayable="$(jq '[.streams[] | select(.url != null)] | length' <<<"$wresp")"
			wtotal="$(jq '.streams | length' <<<"$wresp")"
			print -r -- "lofi: worker status=$wstatus updated=$wupdated playable=$wplayable/$wtotal"
			return 0
		fi

		# json: the resolver document is the health surface. A stale-but-preserved
		# URL is still playable for hours, so the probe checks the freshest entry
		# and reports what it finds rather than blocking on a fresh one.
		local doc status updated playable total probe_url probe
		doc="$(curl -fsS -m 15 "$lofi_base_json")"

		if [[ -z "$doc" ]]; then
			print -u2 "lofi: resolver document unreachable (curl exit $?)"
			return 1
		fi

		status="$(jq -r '.status // "?"' <<<"$doc")"
		updated="$(jq -r '.updated_at // "?"' <<<"$doc")"
		playable="$(jq '[.streams[] | select(.url != null)] | length' <<<"$doc")"
		total="$(jq '.streams | length' <<<"$doc")"

		print -r -- "lofi: document status=$status updated=$updated playable=$playable/$total"

		probe_url="$(jq -r '.streams[] | select(.stale == false) | select(.url != null) | .url' <<<"$doc" | head -n 1)"

		if [[ -z "$probe_url" ]]; then
			print -u2 "lofi: no fresh URL in the document — the resolver has not succeeded since the last good publish"
			return 1
		fi

		if command -v ffprobe > /dev/null 2>&1; then
			# A live m3u8 lists its tracks in the playlist, which ffprobe reads
			# without downloading media. Audio-only (variant audio-only) must
			# show an audio stream and NO video stream.
			probe="$(ffprobe -hide_banner -show_entries stream=codec_type -of csv=p=0 "$probe_url" 2> /dev/null | sort -u)"

			if [[ "$probe" == *audio* && "$probe" != *video* ]]; then
				print -r -- "lofi: probe OK — audio-only stream (fresh entry)"
			elif [[ "$probe" == *video* ]]; then
				print -u2 "lofi: probe shows video in the stream — audio-only variant broken, video bytes would be downloaded"
				return 1
			else
				print -u2 "lofi: probe inconclusive (no stream info; upstream may be down)"
				return 1
			fi
		else
			print -r -- "lofi: ffprobe unavailable — document read succeeded, stream probe skipped"
		fi

		return 0
	fi

	if [[ -z "$1" ]]; then
		print -u2 "No stream specified."
		print -u2 "Use 'lofi -h' for help."
		return 1
	fi

	if [[ "$1" == "-R" ]]; then
		# zsh arrays are 1-indexed, hence the offset — indexing from 0 yields
		# an empty element and a request to /lofi/ with no stream name.
		entry="${streams[1 + RANDOM % ${#streams[@]}]}"
	else
		local candidate
		for candidate in "${streams[@]}"; do
			if [[ "${candidate%%:*}" == "${1#-}" ]]; then
				entry="$candidate"
				break
			fi
		done
	fi

	if [[ -z "$entry" ]]; then
		print -u2 "Unknown option: $1"
		print -u2 "Use 'lofi -h' for help."
		return 1
	fi

	local endpoint="${${entry#*:}%:*}"
	local label="${entry##*:}"

	local dep
	for dep in mpv cava curl jq; do
		if ! command -v "$dep" > /dev/null 2>&1; then
			print -u2 "lofi: $dep is not installed."
			return 1
		fi
	done

	local stream_url="" saved_tty player_pid keepalive_pid="" cover=""

	saved_tty="$(stty -g 2> /dev/null)"

	# Restore the tty on any exit. The child PIDs are not known yet, so this
	# trap is rebuilt (not merely re-armed) as each one is spawned -- see the
	# note at the second trap for why the PIDs must be baked in.
	trap "stty '$saved_tty' 2> /dev/null" EXIT INT TERM

	print -r -- "▶ $label (backend: $backend)"

	if [[ "$backend" == relay ]]; then
		stream_url="$relay_base/lofi/$endpoint"

		# Artwork for the desktop's media widget, via the relay's thumbnail
		# endpoint (which derives the image from the video ID, so it never
		# queues behind yt-dlp). mpv-mpris builds `mpris:artUrl` from
		# --cover-art-files, which takes a *path*, so the image has to exist
		# as a local file.
		#
		# mktemp rather than a fixed name -- a predictable /tmp path is a
		# symlink target, and a fresh path per run stops the widget from
		# redisplaying a previous stream's cached image.
		cover="$(mktemp --suffix=.jpg -t lofi-cover-XXXXXX 2> /dev/null)"

		# Armed before the fetch, so a Ctrl+C mid-download still removes the file.
		trap "
			rm -f '$cover'
			stty '$saved_tty' 2> /dev/null
		" EXIT INT TERM

		if [[ -z "$cover" ]] || ! curl -fsS -m 90 \
			-o "$cover" \
			-H "X-API-Key: $LOFI_API_KEY" \
			"$relay_base/lofi/$endpoint/thumbnail"
		then
			# Artwork is cosmetic: never let it keep the music from playing.
			print -u2 "lofi: could not fetch artwork — continuing without it."
			rm -f "$cover"
			cover=""
		fi

		# The relay spins a free service down after 15 minutes without an
		# *inbound* request. An in-flight stream is outbound, so it never
		# resets that timer and the music dies mid-session. Ping /health to
		# keep the service up. Deliberately tied to playback: the free tier
		# grants only 750 instance hours a month, so a round-the-clock
		# pinger would exhaust the quota and suspend the service.
		(
			while sleep 600; do
				curl -fsS -m 30 -o /dev/null \
					-H "X-API-Key: $LOFI_API_KEY" \
					"$relay_base/health" || true
			done
		) &
		keepalive_pid=$!

		trap "
			kill $keepalive_pid 2> /dev/null
			rm -f '$cover'
			stty '$saved_tty' 2> /dev/null
		" EXIT INT TERM
	else
		# json: one document fetch yields both the artwork's video ID and the
		# current URL. The restart loop re-fetches on every attempt, which is
		# what heals an expired or rotated signed URL (the cron publishes a
		# fresh one every 30 minutes).
		local doc video_id
		if ! doc="$(curl -fsS -m 15 "$lofi_base_json")"; then
			print -u2 "lofi: resolver document unreachable — cannot start."
			print -u2 "lofi: try 'lofi -health', or LOFI_BACKEND=relay lofi $1."
			stty "$saved_tty" 2> /dev/null
			return 1
		fi

		# Name drift is a configuration bug, not a transient: fail fast and
		# say which side moved.
		if ! jq -e --arg e "$endpoint" '.streams | has($e)' <<<"$doc" > /dev/null 2>&1; then
			print -u2 "lofi: '$endpoint' is not in the resolver document — name drift between this script and app/config.py."
			stty "$saved_tty" 2> /dev/null
			return 1
		fi

		cover="$(mktemp --suffix=.jpg -t lofi-cover-XXXXXX 2> /dev/null)"

		trap "
			rm -f '$cover'
			stty '$saved_tty' 2> /dev/null
		" EXIT INT TERM

		video_id="$(jq -r --arg e "$endpoint" '.streams[$e].video_id // empty' <<<"$doc" 2> /dev/null)"

		if [[ -n "$video_id" ]]; then
			# i.ytimg.com is derived from the video ID: no auth, no host, no
			# extraction. maxresdefault is not generated for every video, so
			# hqdefault is the guaranteed fallback.
			curl -fsS -m 15 -o "$cover" \
				"https://i.ytimg.com/vi/$video_id/maxresdefault.jpg" \
			|| curl -fsS -m 15 -o "$cover" \
				"https://i.ytimg.com/vi/$video_id/hqdefault.jpg" \
			|| {
				print -u2 "lofi: could not fetch artwork — continuing without it."
				rm -f "$cover"
				cover=""
			}
		fi
	fi

	local -a mpv_args=(
		--no-video
		--really-quiet
		# Keep mpv's hands off the terminal — cava owns it. This is what the
		# old `stty sane` cleanup was working around.
		--no-input-terminal
		--cache=yes
		--cache-secs=60
		--demuxer-max-bytes=64MiB
		--cache-pause=yes
		--cache-pause-wait=5
		--network-timeout=120
		# Heal brief upstream blips without restarting mpv entirely.
		--stream-lavf-o=reconnect=1,reconnect_streamed=1,reconnect_delay_max=5
		# Name the stream in the media widget; without it the notification
		# shows the bare URL.
		--force-media-title="$label"
	)

	# Only the relay authenticates; the json backend plays a signed public
	# URL and the document is public on purpose (it holds public stream
	# sources and hours-lived signatures, no secrets).
	if [[ "$backend" == relay ]]; then
		mpv_args+=(--http-header-fields="X-API-Key: $LOFI_API_KEY")
	fi

	# Appended only when the fetch succeeded: pointing mpv at a nonexistent
	# file just logs an error and gains nothing.
	if [[ -n "$cover" ]]; then
		mpv_args+=(--cover-art-files="$cover")
	fi

	# Restart mpv if the stream ends: a signed URL rotates when YouTube
	# restarts the channel, and the relay's service may restart at any time
	# on the free tier. The URL is re-acquired on every attempt, which is
	# what heals it.
	(
		trap 'kill $child 2> /dev/null; exit' TERM

		fails=0

		while :; do
			started=$SECONDS
			play_url=""

			if [[ "$backend" == relay ]]; then
				play_url="$stream_url"
			elif [[ "$backend" == worker ]]; then
				play_url="$(lofi_worker_url "$endpoint")"
			else
				play_url="$(lofi_json_url "$endpoint")"

				if [[ -z "$play_url" ]]; then
					# The channel may be offline (its document entry is null)
					# or the document unreachable. Either way the next cron
					# tick (30 min) or the next attempt can heal it.
					print -u2 "lofi: no playable URL for $label yet — retrying in 30s."
					if (( ++fails >= 10 )); then
						print -u2 "lofi: stream keeps failing immediately — giving up."
						print -u2 "lofi: try 'lofi -health'."
						break
					fi
					sleep 30
					continue
				fi
			fi

			mpv "${mpv_args[@]}" "$play_url" &
			child=$!
			wait $child

			if (( SECONDS - started >= 30 )); then
				fails=0
			elif (( ++fails >= 10 )); then
				# Failing instantly and repeatedly means the stream is not
				# coming back (bad endpoint, offline channel, broken document).
				print -u2 "lofi: stream keeps failing immediately — giving up."
				print -u2 "lofi: try 'lofi -health'."
				break
			fi

			sleep 3
		done
	) &
	player_pid=$!

	# The PIDs are baked into the trap body rather than referenced as
	# variables, because zsh unsets a function's locals *before* running its
	# EXIT trap: `$player_pid` would already be empty when the trap fires, so
	# nothing got killed. That orphaned the keep-alive pinger, which then held
	# the relay awake around the clock and would have burned the free tier's
	# 750 monthly instance hours. An empty PID (the json backend runs no
	# pinger) is simply dropped from the word list.
	trap "
		kill $player_pid $keepalive_pid 2> /dev/null
		rm -f '$cover'
		stty '$saved_tty' 2> /dev/null
	" EXIT INT TERM

	cava
}

ytcava() {
	if [[ "$1" == "-h" || "$1" == "--help" ]]; then
		echo "Usage: ytcava <URL>"
		echo ""
		echo "Play audio from a yt-dlp-supported URL with CAVA."
		echo ""
		return 0
	fi

	local url="$1"

	if [[ -z "$url" ]]; then
		print -u2 "No URL specified."
		print -u2 "Use 'ytcava -h' for help."
		return 1
	fi

	local dep
	for dep in mpv cava; do
		if ! command -v "$dep" > /dev/null 2>&1; then
			print -u2 "ytcava: $dep is not installed."
			return 1
		fi
	done

	local mpv_pid saved_tty

	saved_tty="$(stty -g 2> /dev/null)"

	trap "stty '$saved_tty' 2> /dev/null" EXIT INT TERM

	mpv \
		--no-video \
		--really-quiet \
		--no-input-terminal \
		--ytdl-format="234/233/bestaudio/bestaudio" \
		"$url" &
	mpv_pid=$!

	# Baked in, not referenced: zsh clears function locals before the EXIT
	# trap runs, so `$mpv_pid` would be empty and mpv would keep playing
	# after ytcava exited.
	trap "
		kill $mpv_pid 2> /dev/null
		stty '$saved_tty' 2> /dev/null
	" EXIT INT TERM

	cava
}
